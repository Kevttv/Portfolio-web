{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "perf:audit": "pnpm run perf:audit:mobile && pnpm run perf:audit:desktop",
    "perf:audit:mobile": "node ./scripts/perf/local-audit.mjs mobile",
    "perf:audit:desktop": "node ./scripts/perf/local-audit.mjs desktop",
    "perf:ci": "pnpm run perf:ci:mobile && pnpm run perf:ci:desktop",
    "perf:ci:mobile": "lhci autorun --config=./lighthouserc.mobile.json",
    "perf:ci:desktop": "lhci autorun --config=./lighthouserc.desktop.json"
  },
  "dependencies": {
    "@vercel/analytics": "^1.4.1",
    "lucide-react": "^0.475.0",
    "next": "^15.5.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.9",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
