{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3002/es"
      ],
      "startServerCommand": "pnpm start --port 3002",
      "startServerReadyPattern": "Ready",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 1800
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 1000
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 100
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.05
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
